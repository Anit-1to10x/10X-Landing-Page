{
  "fonts": {
    "heading": {
      "family": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "weights": {
        "semibold": 600,
        "bold": 700
      }
    },
    "body": {
      "family": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600
      }
    },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  },
  "scale": {
    "h1": {
      "fontSize": "clamp(2.5rem, 5vw, 4rem)",
      "fontWeight": 700,
      "lineHeight": 1.1,
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "fontSize": "clamp(2rem, 4vw, 3rem)",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "-0.02em"
    },
    "h3": {
      "fontSize": "clamp(1.5rem, 3vw, 2rem)",
      "fontWeight": 600,
      "lineHeight": 1.3,
      "letterSpacing": "-0.01em"
    },
    "h4": {
      "fontSize": "clamp(1.25rem, 2vw, 1.5rem)",
      "fontWeight": 600,
      "lineHeight": 1.4,
      "letterSpacing": "-0.01em"
    },
    "bodyLarge": {
      "fontSize": "1.125rem",
      "fontWeight": 400,
      "lineHeight": 1.6,
      "letterSpacing": "0"
    },
    "body": {
      "fontSize": "1rem",
      "fontWeight": 400,
      "lineHeight": 1.6,
      "letterSpacing": "0"
    },
    "bodySmall": {
      "fontSize": "0.875rem",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "letterSpacing": "0"
    },
    "caption": {
      "fontSize": "0.75rem",
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": "0.02em"
    },
    "button": {
      "fontSize": "1rem",
      "fontWeight": 600,
      "lineHeight": 1,
      "letterSpacing": "0"
    },
    "buttonSmall": {
      "fontSize": "0.875rem",
      "fontWeight": 600,
      "lineHeight": 1,
      "letterSpacing": "0"
    },
    "navLink": {
      "fontSize": "0.9375rem",
      "fontWeight": 500,
      "lineHeight": 1,
      "letterSpacing": "0"
    }
  },
  "defaults": {
    "headingColor": "#111827",
    "bodyColor": "#4B5563",
    "mutedColor": "#9CA3AF",
    "linkColor": "#6366F1",
    "linkHoverColor": "#4F46E5"
  }
}
